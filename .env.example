# Copy this file to ".env" and fill in your own key. NEVER commit .env to Git.
GOOGLE_API_KEY=your_api_key_here

# Primary model. Change it here if Google retires it (run `python list_models.py` to see what your key can use).
GEMINI_MODEL=gemini-3.6-flash
# Comma-separated models tried automatically if the primary one is unavailable (404).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash

# Generation + usage limits (Activity 1.2)
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_MAX_RETRIES=3
GEMINI_MAX_CALLS_PER_MINUTE=10
SECRET_KEY=<paste the generated value>
